# Supabase – Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable klíč (sb_publishable_…); funguje i starší NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# POUZE server (Vercel env, nikdy NEXT_PUBLIC_) – pozvánky, deaktivace účtů, e-mailová fronta
# secret klíč (sb_secret_…) nebo service_role – Project Settings → API Keys
SUPABASE_SERVICE_ROLE_KEY=

# Veřejná adresa aplikace (odkazy v e-mailech)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mailová upozornění (Resend) – nepovinné; bez nich fungují upozornění v aplikaci
RESEND_API_KEY=
EMAIL_FROM="Kluziště Praha <hub@vase-domena.cz>"
# Náhodný řetězec pro zabezpečení /api/cron/emails (Vercel jej posílá automaticky)
CRON_SECRET=

# Jen pro scripts/seed-demo.mjs
DEMO_PASSWORD=
